generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                              String                           @id @default(cuid())
  email                           String                           @unique
  name                            String?
  passwordHash                    String
  emailVerifiedAt                 DateTime?
  authVersion                     Int                              @default(0)
  accountTier                     AccountTier                      @default(FREE)
  preferredTranslation            String                           @default("web")
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  studySessions                   StudySession[]
  studyGraphSessions              StudyGraphSession[]
  studyGraphNodes                 StudyGraphNode[]
  studyGraphEdges                 StudyGraphEdge[]
  dailyQuotaUsages                DailyQuotaUsage[]
  usageEvents                     UsageEvent[]
  studyThreads                    StudyThread[]
  studyMessages                   StudyMessage[]
  accountTokens                   AccountToken[]
  memorizationPassages            MemorizationPassage[]
  memorizationAttempts            MemorizationAttempt[]
  memorizationRecommendationCache MemorizationRecommendationCache?
}

model MemorizationPassage {
  id                    String                @id @default(cuid())
  userId                String
  translation           String
  reference             String
  book                  String
  bookOrder             Int
  chapter               Int
  verseStart            Int
  verseEnd              Int
  isWholeChapter        Boolean               @default(false)
  text                  String
  verses                Json
  editionSnapshot       Json?
  textAttemptCount      Int                   @default(0)
  latestTextScore       Int?
  bestTextScore         Int?
  referenceAttemptCount Int                   @default(0)
  latestReferenceScore  Int?
  bestReferenceScore    Int?
  lastPracticedAt       DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts              MemorizationAttempt[]

  @@unique([userId, translation, bookOrder, chapter, verseStart, verseEnd])
  @@index([userId, updatedAt])
  @@index([userId, bookOrder, chapter, verseStart])
}

model MemorizationAttempt {
  id        String                  @id @default(cuid())
  passageId String
  userId    String
  mode      MemorizationAttemptMode
  score     Int
  wordCount Int
  createdAt DateTime                @default(now())
  passage   MemorizationPassage     @relation(fields: [passageId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([passageId, createdAt])
  @@index([userId, createdAt])
}

model MemorizationRecommendationCache {
  id                String   @id @default(cuid())
  userId            String   @unique
  sourceFingerprint String
  translation       String
  model             String
  payload           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceFingerprint])
}

enum MemorizationAttemptMode {
  TEXT
  REFERENCE
}

model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AccountTier {
  FREE
  PAID
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String?
  passage         String
  context         String?
  summary         String
  recommendations Json
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model BibleVerse {
  id          Int    @id @default(autoincrement())
  translation String
  bookCode    String
  book        String
  bookOrder   Int
  chapter     Int
  verse       Int
  paragraph   Int    @default(1)
  text        String

  @@unique([translation, bookOrder, chapter, verse])
  @@index([translation, book, chapter, verse])
  @@index([translation, bookOrder, chapter])
}

model BibleFootnote {
  id          Int     @id @default(autoincrement())
  translation String
  bookCode    String
  book        String
  bookOrder   Int
  chapter     Int
  verse       Int
  kind        String
  caller      String?
  text        String

  @@index([translation, book, chapter, verse])
  @@index([translation, bookOrder, chapter, verse])
}

model BibleWord {
  id          Int     @id @default(autoincrement())
  translation String
  bookCode    String
  book        String
  bookOrder   Int
  chapter     Int
  verse       Int
  position    Int
  text        String
  lemma       String?
  strong      String?
  morph       String?

  @@unique([translation, bookOrder, chapter, verse, position])
  @@index([translation, book, chapter, verse])
  @@index([translation, strong])
  @@index([translation, lemma])
}

model BibleLexicon {
  id            Int      @id @default(autoincrement())
  strong        String   @unique
  language      String
  lemma         String
  translit      String?
  pronunciation String?
  derivation    String?
  strongsDef    String?
  kjvDef        String?
  source        String
  importedAt    DateTime @default(now())

  @@index([language])
  @@index([lemma])
}

model WordLensCache {
  id                String   @id @default(cuid())
  cacheKey          String   @unique
  kind              String
  reference         String
  sourceTranslation String
  targetTranslation String
  model             String
  promptVersion     String
  payload           Json
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kind, expiresAt])
}

model StudyGraphNode {
  id            String             @id @default(cuid())
  userId        String
  sessionId     String
  kind          StudyGraphNodeKind
  mode          String?
  passageRef    String?
  promptText    String?
  normalizedKey String?
  translation   String?
  isUserInput   Boolean            @default(false)
  answer        String?
  context       String?
  relevance     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  session       StudyGraphSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingEdges StudyGraphEdge[]   @relation("StudyGraphEdgeFrom")
  incomingEdges StudyGraphEdge[]   @relation("StudyGraphEdgeTo")

  @@unique([sessionId, kind, translation, normalizedKey])
  @@index([userId, sessionId, createdAt])
  @@index([userId, sessionId, kind, normalizedKey])
}

model StudyGraphEdge {
  id            String             @id @default(cuid())
  userId        String
  sessionId     String
  fromNodeId    String
  toNodeId      String
  kind          StudyGraphEdgeKind
  selectionKind String?
  stepIndex     Int
  reason        String?
  application   String?
  confidence    Float?
  createdAt     DateTime           @default(now())
  session       StudyGraphSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromNode      StudyGraphNode     @relation("StudyGraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode        StudyGraphNode     @relation("StudyGraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, kind, stepIndex])
  @@index([userId, sessionId, createdAt])
  @@index([fromNodeId, kind, createdAt])
}

model StudyGraphSession {
  id        String           @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes     StudyGraphNode[]
  edges     StudyGraphEdge[]

  @@index([userId, createdAt])
}

enum StudyGraphNodeKind {
  PROMPT
  VERSE
}

enum StudyGraphEdgeKind {
  SELECTS
  RECOMMENDS
}

model DailyQuotaUsage {
  id           String       @id @default(cuid())
  actorKey     String
  userId       String?
  feature      QuotaFeature
  day          DateTime
  requestCount Int          @default(0)
  tokenCount   Int          @default(0)
  windowStart  DateTime
  windowCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([actorKey, feature, day])
  @@index([userId, day])
  @@index([feature, day])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model UsageEvent {
  id         String       @id @default(cuid())
  feature    UsageFeature
  pagePath   String
  apiRoute   String
  action     String
  sourcePath String?
  sourceHost String?
  userId     String?
  anonId     String?
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([feature, createdAt])
  @@index([pagePath, createdAt])
  @@index([userId, createdAt])
  @@index([anonId, createdAt])
}

enum QuotaFeature {
  STUDY
  INTERLINEAR
}

enum UsageFeature {
  STUDY
  COMPARE
  WORD_LENS
}

model StudyThread {
  id          String         @id @default(cuid())
  userId      String
  title       String?
  translation String?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    StudyMessage[]

  @@index([userId, updatedAt])
  @@index([userId, archivedAt, updatedAt])
}

model StudyMessage {
  id          String           @id @default(cuid())
  threadId    String
  userId      String
  role        StudyMessageRole
  kind        String?
  content     String
  translation String?
  response    Json?
  createdAt   DateTime         @default(now())
  thread      StudyThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId, createdAt])
}

enum StudyMessageRole {
  USER
  ASSISTANT
}
