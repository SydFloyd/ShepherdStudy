generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  studySessions StudySession[]
  studyGraphSessions StudyGraphSession[]
  studyGraphNodes StudyGraphNode[]
  studyGraphEdges StudyGraphEdge[]
  dailyQuotaUsages DailyQuotaUsage[]
  studyThreads StudyThread[]
  studyMessages StudyMessage[]
  wwjdThreads  WwjdThread[]
  wwjdMessages WwjdMessage[]
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String?
  passage         String
  context         String?
  summary         String
  recommendations Json
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model BibleVerse {
  id          Int    @id @default(autoincrement())
  translation String
  bookCode    String
  book        String
  bookOrder   Int
  chapter     Int
  verse       Int
  paragraph   Int    @default(1)
  text        String

  @@unique([translation, bookOrder, chapter, verse])
  @@index([translation, book, chapter, verse])
  @@index([translation, bookOrder, chapter])
}

model BibleFootnote {
  id          Int    @id @default(autoincrement())
  translation String
  bookCode    String
  book        String
  bookOrder   Int
  chapter     Int
  verse       Int
  kind        String
  caller      String?
  text        String

  @@index([translation, book, chapter, verse])
  @@index([translation, bookOrder, chapter, verse])
}

model StudyGraphNode {
  id            String            @id @default(cuid())
  userId        String
  sessionId     String
  kind          StudyGraphNodeKind
  mode          String?
  passageRef    String?
  promptText    String?
  normalizedKey String?
  translation   String?
  isUserInput   Boolean           @default(false)
  answer        String?
  context       String?
  relevance     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  session       StudyGraphSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingEdges StudyGraphEdge[]  @relation("StudyGraphEdgeFrom")
  incomingEdges StudyGraphEdge[]  @relation("StudyGraphEdgeTo")

  @@index([userId, sessionId, createdAt])
  @@index([userId, sessionId, kind, normalizedKey])
  @@unique([sessionId, kind, translation, normalizedKey])
}

model StudyGraphEdge {
  id          String           @id @default(cuid())
  userId      String
  sessionId   String
  fromNodeId  String
  toNodeId    String
  kind        StudyGraphEdgeKind
  selectionKind String?
  stepIndex   Int
  reason      String?
  application String?
  confidence  Float?
  createdAt   DateTime         @default(now())
  session     StudyGraphSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromNode    StudyGraphNode   @relation("StudyGraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode      StudyGraphNode   @relation("StudyGraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, createdAt])
  @@index([fromNodeId, kind, createdAt])
  @@unique([fromNodeId, toNodeId, kind, stepIndex])
}

model StudyGraphSession {
  id        String           @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes     StudyGraphNode[]
  edges     StudyGraphEdge[]

  @@index([userId, createdAt])
}

enum StudyGraphNodeKind {
  PROMPT
  VERSE
}

enum StudyGraphEdgeKind {
  SELECTS
  RECOMMENDS
}

model DailyQuotaUsage {
  id           String       @id @default(cuid())
  actorKey     String
  userId       String?
  feature      QuotaFeature
  day          DateTime
  requestCount Int          @default(0)
  tokenCount   Int          @default(0)
  windowStart  DateTime
  windowCount  Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([actorKey, feature, day])
  @@index([userId, day])
  @@index([feature, day])
}

enum QuotaFeature {
  STUDY
  WWJD
}

model StudyThread {
  id          String         @id @default(cuid())
  userId      String
  title       String?
  translation String?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    StudyMessage[]

  @@index([userId, updatedAt])
  @@index([userId, archivedAt, updatedAt])
}

model StudyMessage {
  id          String           @id @default(cuid())
  threadId    String
  userId      String
  role        StudyMessageRole
  kind        String?
  content     String
  translation String?
  response    Json?
  createdAt   DateTime         @default(now())
  thread      StudyThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId, createdAt])
}

enum StudyMessageRole {
  USER
  ASSISTANT
}

model WwjdThread {
  id          String        @id @default(cuid())
  userId      String
  title       String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    WwjdMessage[]

  @@index([userId, updatedAt])
  @@index([userId, archivedAt, updatedAt])
}

model WwjdMessage {
  id              String           @id @default(cuid())
  threadId         String
  userId           String
  role             StudyMessageRole
  content          String
  recommendations  Json?
  createdAt        DateTime         @default(now())
  thread           WwjdThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId, createdAt])
}
