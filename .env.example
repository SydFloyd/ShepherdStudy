# Neon pooled URL (runtime, usually has -pooler host)
DATABASE_URL="postgresql://USER:PASSWORD@EP-XXX-POOLER.us-east-2.aws.neon.tech/DB?sslmode=require&channel_binding=require"
# Neon direct URL (migrations, usually non-pooler host)
DIRECT_URL="postgresql://USER:PASSWORD@EP-XXX.us-east-2.aws.neon.tech/DB?sslmode=require&channel_binding=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Optional paid-tier model. Keep empty until representative quality/cost evals pass.
OPENAI_PAID_MODEL=""
# Optional: explicitly route calls to a specific OpenAI project/org.
# OPENAI_PROJECT="proj_..."
# OPENAI_ORGANIZATION="org_..."
STUDY_DAILY_LIMIT="40"
INTERLINEAR_DAILY_LIMIT="120"
STUDY_BURST_PER_MINUTE="8"
INTERLINEAR_BURST_PER_MINUTE="20"
ANONYMOUS_STUDY_DAILY_LIMIT="5"
ANONYMOUS_INTERLINEAR_DAILY_LIMIT="20"
ANONYMOUS_STUDY_BURST_PER_MINUTE="3"
ANONYMOUS_INTERLINEAR_BURST_PER_MINUTE="8"
PAID_STUDY_DAILY_LIMIT="2000"
PAID_INTERLINEAR_DAILY_LIMIT="5000"
PAID_STUDY_BURST_PER_MINUTE="30"
PAID_INTERLINEAR_BURST_PER_MINUTE="60"
# Optional dedicated HMAC secret for pseudonymous anonymous quota keys.
# Falls back to NEXTAUTH_SECRET when omitted.
QUOTA_ACTOR_SECRET=""
RATE_LIMIT_SECRET="" # optional dedicated HMAC secret; falls back to QUOTA_ACTOR_SECRET/NEXTAUTH_SECRET
# Optional shared secret (32+ random characters) added by a trusted Cloudflare
# proxy as x-shepherdstudy-cloudflare-proxy-secret. Leave empty on direct Vercel.
CLOUDFLARE_PROXY_SECRET=""
LOGIN_FAILURES_PER_15_MINUTES="30"
LOGIN_ACCOUNT_FAILURES_PER_15_MINUTES="8"
REGISTRATIONS_PER_HOUR="5"
REGISTRATION_ACCOUNT_ATTEMPTS_PER_HOUR="3"
ACCOUNT_EMAILS_PER_HOUR="8"
ACCOUNT_EMAIL_ATTEMPTS_PER_HOUR="4"
PASSWORD_RESET_CONFIRMATIONS_PER_15_MINUTES="20"
PASSWORD_RESET_TOKEN_ATTEMPTS_PER_15_MINUTES="5"
DONATION_CHECKOUTS_PER_15_MINUTES="10"
MEMORIZATION_RECOMMENDATIONS_PER_HOUR="3"
MEMORIZATION_RECOMMENDATIONS_PER_DAY="10"
MEMORIZATION_ATTEMPTS_PER_HOUR="300"
DBS_READS_PER_10_MINUTES="120" # public on-demand DBS chapter reads per IP-derived actor
DBS_GLOBAL_READS_PER_10_MINUTES="5000" # aggregate public DBS-backed reads across all actors
POSTMARK_API_KEY="" # ShepStudy server token; never expose with NEXT_PUBLIC_
POSTMARK_FROM_EMAIL="" # verified Postmark sender address or address on a verified domain
POSTMARK_FROM_NAME="ShepherdStudy"
POSTMARK_MESSAGE_STREAM="outbound"
ACCOUNT_EMAIL_BASE_URL="" # optional canonical HTTPS origin; falls back to NEXTAUTH_URL
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_TUNNEL_ROUTE=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
ADMIN_METRICS_KEY="" # required to be at least 16 characters when enabled
ADMIN_EMAILS="" # comma-separated admin emails for /admin access
CRON_SECRET="" # at least 16 random characters; Vercel sends it as a bearer token
NEXT_PUBLIC_STUDY_HISTORY_RECENT_TURNS="8"
WORD_LENS_CACHE_TTL_HOURS="168" # 7 days
# Optional DBS-compatible origin override for development/testing. Production
# defaults to https://arc.dbs.org and requires HTTPS when overridden.
DBS_API_BASE_URL=""
TURNSTILE_SITE_KEY="" # optional public override; defaults to the configured widget
TURNSTILE_SECRET="" # required server-side; never expose with NEXT_PUBLIC_
TURNSTILE_SECRET_KEY="" # optional alias for platforms that provide this name
TURNSTILE_HOSTNAMES="localhost,127.0.0.1" # optional when NEXTAUTH_URL has the exact public hostname
STRIPE_SECRET_KEY="" # required for optional contributions; server-only, never expose with NEXT_PUBLIC_
STRIPE_PUBLISHABLE_KEY="" # reserved for a future embedded checkout; hosted Checkout does not use it
DONATION_MIN_USD="3.00"
DONATION_MAX_USD="500.00"
